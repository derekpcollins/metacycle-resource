{
  "name": "metacycle-resource",
  "version": "0.1.0",
  "description": "Community-maintained owner resource for the Sondors Metacycle",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "validate": "astro sync",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ci": "npm run format:check && npm run forms:check && npm run check && npm run build && npm run test:a11y && npm run test:validation && npm run test:contribution && npm run test:links",
    "test:validation": "node scripts/test-validation.mjs",
    "verify:list": "tsx scripts/verify-list.ts",
    "links:check": "tsx scripts/link-check.ts",
    "changelog": "tsx scripts/changelog.ts",
    "forms:sync": "tsx scripts/sync-issue-forms.ts",
    "forms:check": "tsx scripts/sync-issue-forms.ts --check",
    "labels:sync": "tsx scripts/sync-labels.ts",
    "test:contribution": "tsx scripts/test-contribution.ts",
    "test:links": "tsx scripts/test-link-check.ts",
    "serve:local": "tsx scripts/serve-local.ts",
    "test:a11y": "tsx scripts/test-a11y.ts"
  },
  "license": "SEE LICENSE IN LICENSE-CODE and LICENSE-CONTENT",
  "dependencies": {
    "@astrojs/mdx": "^8.1.5",
    "astro": "^7.4.11"
  },
