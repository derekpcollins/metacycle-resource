---
import BaseLayout from '../layouts/BaseLayout.astro';
import EmptyState from '../components/EmptyState.astro';
import {
  buses,
  downloads,
  downloadsSource,
  fuses,
  gaps,
  pinouts,
  specSections,
  type SpecRow,
} from '../data/specs';

const allRows: SpecRow[] = [...specSections.flatMap((x) => x.rows), ...fuses, ...buses];
const sources = [
  ...new Set([...allRows.map((r) => r.source), ...pinouts.map((p) => p.source), downloadsSource]),
];
const pad = (n: number) => String(n).padStart(2, '0');
let n = 1;
const num = () => pad(n++);
---

<BaseLayout
  title="Specs"
  description="Sondors Metacycle spec sheet, fuse map, connector pinouts and downloads, with a source for every value."
  editPath="src/data/specs.ts"
  sources={sources}
>
  <div class="wrap">
    <header class="page-head">
      <h1>Specs</h1>
      <p class="lede">
        Spec sheet, fuse map, connector pinouts and downloads. Every value links to its source.
      </p>
    </header>

    <nav class="toc" aria-label="On this page">
      <ul>
        <li>
          <a href="#sheet">spec sheet</a>
        </li>
        <li>
          <a href="#fuses">fuses</a>
        </li>
        <li>
          <a href="#pinouts">pinouts</a>
        </li>
        <li>
          <a href="#downloads">downloads</a>
        </li>
        <li>
          <a href="#gaps">not yet known</a>
        </li>
      </ul>
    </nav>

    <section class="block" id="sheet" aria-labelledby="h-sheet">
      <h2 class="block-title" id="h-sheet">
        <span class="n">{num()}</span> Spec sheet
      </h2>
      {specSections.map((sec) => (
        <div class="group">
          <h3 class="label group-title" id={`spec-${sec.id}`}>
            {sec.title.toLowerCase()}
          </h3>
          <table class="data-table sheet" aria-labelledby={`spec-${sec.id}`}>
            <tbody>
              {sec.rows.map((r) => (
                <tr>
                  <th scope="row">{r.label}</th>
                  <td>
                    <span class="v">{r.value}</span>
                    {r.note && <span class="note">{r.note}</span>}
                    <span class="src">
                      <a href={r.source}>{r.sourceLabel}</a>
                      {r.part && (
                        <>
                          {' · '}
                          <a href={`/parts/${r.part}`}>part page</a>
                        </>
                      )}
                    </span>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      ))}
    </section>

    <section class="block" id="fuses" aria-labelledby="h-fuses">
      <h2 class="block-title" id="h-fuses">
        <span class="n">{num()}</span> Fuses
      </h2>
      <table class="data-table sheet">
        <caption class="visually-hidden">Fuses</caption>
        <tbody>
          {fuses.map((r) => (
            <tr>
              <th scope="row">{r.label}</th>
              <td>
                <span class="v">{r.value}</span>
                {r.note && <span class="note">{r.note}</span>}
                <span class="src">
                  <a href={r.source}>{r.sourceLabel}</a>
                  {r.part && (
                    <>
                      {' · '}
                      <a href={`/parts/${r.part}`}>part page</a>
                    </>
                  )}
                </span>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
      <p class="caption">
        No full fuse map exists yet: only these two fuses are documented. Know where others are?{' '}
        <a href="/contribute">Share it</a>.
      </p>
    </section>

    <section class="block" id="pinouts" aria-labelledby="h-pinouts">
      <h2 class="block-title" id="h-pinouts">
        <span class="n">{num()}</span> Connector pinouts
      </h2>
      {pinouts.map((p) => (
        <div class="group">
          <h3 class="label group-title" id={`pin-${p.id}`}>
            {p.title.toLowerCase()}
          </h3>
          <table class="data-table pins" aria-labelledby={`pin-${p.id}`}>
            <thead>
              <tr>
                <th scope="col">pin / wire</th>
                <th scope="col">signal</th>
              </tr>
            </thead>
            <tbody>
              {p.rows.map((r) => (
                <tr>
                  <th scope="row">{r.pin}</th>
                  <td>{r.signal}</td>
                </tr>
              ))}
            </tbody>
          </table>
          {p.note && <p class="pin-note">{p.note}</p>}
          <p class="caption">
            source: <a href={p.source}>{p.sourceLabel}</a>
          </p>
        </div>
      ))}
      <div class="group">
        <h3 class="label group-title" id="pin-buses">
          bus speeds
        </h3>
        <table class="data-table sheet" aria-labelledby="pin-buses">
          <tbody>
            {buses.map((r) => (
              <tr>
                <th scope="row">{r.label}</th>
                <td>
                  <span class="v">{r.value}</span>
                  <span class="src">
                    <a href={r.source}>{r.sourceLabel}</a>
                  </span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="block" id="downloads" aria-labelledby="h-downloads">
      <h2 class="block-title" id="h-downloads">
        <span class="n">{num()}</span> Downloads
      </h2>
      <EmptyState title="coming in phase 6">
        <p>
          Mirrored copies (with origin, date and checksum) will live in a separate downloads
          repository. Until then, the files below are on{' '}
          <a href={downloadsSource}>Metacyclopedia’s Files page</a>.
        </p>
      </EmptyState>
      <div class="dl">
        {downloads.map((g) => (
          <div>
            <h3 class="label group-title">{g.group.toLowerCase()}</h3>
            <ul>
              {g.files.map((f) => (
                <li>{f}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <section class="block" id="gaps" aria-labelledby="h-gaps">
      <h2 class="block-title" id="h-gaps">
        <span class="n">{num()}</span> Not yet known
      </h2>
      <ul class="gaps">
        {gaps.map((g) => (
          <li>{g}</li>
        ))}
      </ul>
      <p class="caption">
        No source documents these yet. Have the manual page, a measurement or a photo?{' '}
        <a href="/contribute">Help fill the gap</a>.
      </p>
    </section>
  </div>
</BaseLayout>

<style>
  .toc ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-5);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }
  .toc a {
    display: inline-block;
    padding: var(--space-2) 0;
  }
  .group {
    padding-top: var(--space-5);
  }
  .group-title {
    margin: 0 0 var(--space-1);
    font-weight: 400;
  }
  .sheet,
  .pins {
    width: 100%;
  }
  .sheet th {
    width: 40%;
  }
  .sheet td {
    color: var(--color-text);
  }
  .v,
  .note,
  .src {
    display: block;
  }
  .note {
    margin-top: var(--space-1);
    color: var(--color-text-muted);
    font-family: var(--font-sans);
  }
  .src {
    margin-top: var(--space-1);
    font-size: var(--text-xs);
  }
  .src a {
    color: var(--color-text-muted);
  }
  .pins th {
    width: 40%;
  }
  .pin-note {
    margin: var(--space-3) 0 0;
    max-width: var(--measure);
  }
  .dl {
    display: grid;
    gap: 0 var(--space-10);
  }
  .dl ul,
  .gaps {
    margin: var(--space-2) 0 var(--space-4);
    padding-left: 1.2em;
  }
  .dl li,
  .gaps li {
    padding: var(--space-1) 0;
  }
  @media (min-width: 60rem) {
    .dl {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
