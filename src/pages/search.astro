---
/**
 * Search results, powered by Pagefind (static index built by the pagefind integration in
 * astro.config.mjs after `astro build`). Reads ?q= from the URL.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Search" editPath="src/pages/search.astro">
  <div class="wrap">
    <header class="page-head">
      <h1>Search</h1>
      <p class="lede">Parts (including what owners call them), guides and symptoms.</p>
    </header>
    <div id="search" class="pf"></div>
    <noscript>
      <p>
        Search needs JavaScript. Browse instead: <a href="/parts">parts</a> ·
        <a href="/troubleshooting">symptoms</a> · <a href="/guides">guides</a>.
      </p>
    </noscript>
    <p class="caption" id="search-dev-note" hidden>
      The search index is built with <code>npm run build</code>; it isn’t available in
      <code>astro dev</code>.
    </p>
  </div>
  <link rel="stylesheet" href="/pagefind/pagefind-ui.css" />
  <script is:inline>
    (function () {
      var s = document.createElement('script');
      s.src = '/pagefind/pagefind-ui.js';
      s.onload = function () {
        var ui = new PagefindUI({
          element: '#search',
          showSubResults: false,
          showImages: false,
          resetStyles: false,
          autofocus: true,
          translations: { placeholder: 'part, symptom or guide' },
        });
        var q = new URLSearchParams(location.search).get('q');
        if (q) {
          ui.triggerSearch(q);
          // Race fix: if the filter list finishes loading after this first search, Pagefind
          // UI shows whole-index counts (e.g. "Part (42)" for 1 result). Re-run the search
          // once the filter panel exists so the counts match the results.
          var root = document.getElementById('search');
          var mo = new MutationObserver(function () {
            if (!root.querySelector('.pagefind-ui__filter-panel')) return;
            mo.disconnect();
            var input = root.querySelector('.pagefind-ui__search-input');
            var term = (input && input.value) || q;
            ui.triggerSearch(term + ' ');
            setTimeout(function () {
              ui.triggerSearch(term);
            }, 0);
          });
          mo.observe(root, { childList: true, subtree: true });
        }
        // Keep ?q= in sync so results can be shared or reloaded.
        document.addEventListener('input', function (e) {
          var t = e.target;
          if (!t || !t.classList || !t.classList.contains('pagefind-ui__search-input')) return;
          var u = new URL(location.href);
          if (t.value) u.searchParams.set('q', t.value);
          else u.searchParams.delete('q');
          history.replaceState(null, '', u);
        });
      };
      s.onerror = function () {
        document.getElementById('search-dev-note').hidden = false;
      };
      document.body.appendChild(s);
    })();
  </script>
</BaseLayout>

<style is:global>
  /* Pagefind default UI, mapped onto our tokens. Rules are scoped with #search so they
     beat Pagefind's own stylesheet (its selectors carry two or three classes and load
     after ours). */
  .pf {
    --pagefind-ui-scale: 1;
    --pagefind-ui-primary: var(--color-text);
    --pagefind-ui-text: var(--color-text);
    --pagefind-ui-background: var(--color-bg);
    --pagefind-ui-border: var(--color-rule-strong);
    --pagefind-ui-tag: var(--color-surface);
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: 0;
    --pagefind-ui-image-border-radius: 0;
    --pagefind-ui-font: var(--font-sans);
  }
  #search .pagefind-ui__search-input {
    font-family: var(--font-mono);
    font-size: var(--text-base);
    font-weight: 400;
    height: 56px;
    padding-right: 7rem; /* room for the Clear button */
  }
  #search .pagefind-ui__search-input::placeholder {
    color: var(--color-text-muted);
    opacity: 1;
  }
  /* Clear uses the shared .btn spec (base.css). */
  #search .pagefind-ui__search-clear {
    top: 4px;
    right: 4px;
    height: 48px;
    min-height: 0;
    padding: 0 var(--space-5);
    border: var(--border) solid var(--color-rule-strong);
    border-radius: var(--radius-0);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 600;
    background: transparent;
    color: var(--color-text);
  }
  #search .pagefind-ui__button {
    min-height: var(--tap-target);
    padding: 0 var(--space-5);
    border: var(--border) solid var(--color-rule-strong);
    border-radius: var(--radius-0);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 600;
    background: transparent;
    color: var(--color-text);
  }
  /* One hover for every button: safety-yellow fill, ink text. */
  #search .pagefind-ui__search-clear:hover,
  #search .pagefind-ui__button:hover {
    background: var(--color-accent);
    color: var(--color-on-accent);
    border-color: var(--color-rule-strong);
  }
  #search .pagefind-ui__message,
  #search .pagefind-ui__filter-name,
  #search .pagefind-ui__result-tag {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }
  /* Results match the home page rows: inset text so the hover fill has side margins. */
  #search .pagefind-ui__result {
    position: relative;
    padding: var(--space-4) var(--space-2);
    border-top: var(--border) solid var(--color-rule);
  }
  #search .pagefind-ui__result:hover {
    background: var(--color-surface);
  }
  #search .pagefind-ui__result-link::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  #search .pagefind-ui__result-title {
    font-family: var(--font-sans);
    font-size: var(--text-lg);
  }
  #search .pagefind-ui__result-link {
    color: var(--color-text);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  #search .pagefind-ui__result-excerpt {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }
  #search mark {
    background: var(--color-mark);
    color: var(--color-text);
  }
  #search .pagefind-ui__filter-checkbox {
    width: 20px;
    height: 20px;
  }
</style>
