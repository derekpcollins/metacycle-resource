---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { TOOL_CATEGORIES } from '../../lib/enums';
import { guidesUsingTool, repoPath } from '../../lib/content';

export async function getStaticPaths() {
  return (await getCollection('tools')).map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}
const { entry } = Astro.props as { entry: CollectionEntry<'tools'> };
const d = entry.data;
const usedIn = await guidesUsingTool(entry.id);
---

<BaseLayout
  title={d.name}
  description={`${d.name} (${d.spec}) for Sondors Metacycle work${usedIn.length ? `, used in ${usedIn.length} guide${usedIn.length === 1 ? '' : 's'}` : ''}.`}
  editPath={repoPath(entry)}
  contributors={d.contributors}
>
  <div class="wrap">
    <nav class="crumbs" aria-label="Breadcrumb">
      <ol>
        <li>
          <a href="/tools">tools</a>
        </li>
        <li aria-current="page">{entry.id}</li>
      </ol>
    </nav>
    <header class="page-head">
      <p class="label kicker">tool</p>
      <h1>{d.name}</h1>
      <dl class="kv">
        <div>
          <dt>spec</dt>
          <dd>{d.spec}</dd>
        </div>
        <div>
          <dt>category</dt>
          <dd>{TOOL_CATEGORIES[d.category].toLowerCase()}</dd>
        </div>
        <div>
          <dt>starter kit</dt>
          <dd>{d.essential ? 'yes' : 'no'}</dd>
        </div>
      </dl>
    </header>

    <div class="layout">
      <div>
        <section class="block" aria-labelledby="h-used">
          <h2 class="block-title" id="h-used">
            <span class="n">01</span>Used in
          </h2>
          {usedIn.length ? (
            <ul class="rows">
              {usedIn.map((g) => (
                <li>
                  <a href={`/guides/${g.id}`}>
                    <span class="t">{g.data.title}</span>
                    <span class="go" aria-hidden="true">
                      →
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          ) : (
            <p class="muted none">No guides yet.</p>
          )}
        </section>
      </div>
      <aside class="side" aria-label="Where to buy">
        <section>
          <h2>Where to buy</h2>
          {d.buy_links.length ? (
            <ul>
              {d.buy_links.map((l) => (
                <li>
                  {l.url === 'TODO' ? (
                    <span>
                      {l.vendor} <span class="todo">link not added yet</span>
                    </span>
                  ) : (
                    <a
                      class="ext"
                      href={l.url}
                      rel={l.affiliate ? 'sponsored noopener' : 'nofollow noopener noreferrer'}
                    >
                      {l.vendor}
                    </a>
                  )}
                  {l.affiliate && <span class="label"> (affiliate link)</span>}
                </li>
              ))}
            </ul>
          ) : (
            <p class="muted">No buy links yet.</p>
          )}
        </section>
      </aside>
    </div>
  </div>
</BaseLayout>

<style>
  .kicker {
    margin: 0 0 var(--space-2);
  }
  .none {
    padding-top: var(--space-4);
  }
</style>
