---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { TOOL_CATEGORIES } from '../../lib/enums';
const tools = (await getCollection('tools')).sort((a, b) => a.data.name.localeCompare(b.data.name));
const groups = [
  { label: 'Starter kit', items: tools.filter((t) => t.data.essential) },
  { label: 'Everything else', items: tools.filter((t) => !t.data.essential) },
];
---

<BaseLayout title="Tools" editPath="src/pages/tools/index.astro">
  <h1>Tools</h1>
  {groups.map((g) => g.items.length > 0 && (
    <>
      <h2>{g.label}</h2>
      <ul>{g.items.map((t) => <li><a href={`/tools/${t.id}`}>{t.data.name}</a> <span class="muted">— {TOOL_CATEGORIES[t.data.category]}</span></li>)}</ul>
    </>
  ))}
</BaseLayout>
