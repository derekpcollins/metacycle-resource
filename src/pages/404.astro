---
import BaseLayout from '../layouts/BaseLayout.astro';
import SearchBox from '../components/SearchBox.astro';
---

<BaseLayout
  title="Page not found"
  description="That page isn’t here. Search parts, guides and symptoms instead."
  editPath="src/pages/404.astro"
  noindex
>
  <div class="wrap">
    <header class="page-head">
      <p class="label">404</p>
      <h1>That page isn’t here.</h1>
      <p class="lede">It may have moved. Try searching, or start from the home page.</p>
    </header>
    <SearchBox id="nf-search" />
    <p class="caption">
      <a href="/">← home</a>
    </p>
  </div>
</BaseLayout>
