---
/**
 * Help Wanted (docs/SPEC.md → Contribute; "Staleness badge"). Generated at build time from
 * content by src/lib/help-wanted.ts: buy links that need a check, unknown (TODO) values,
 * the Specs page's gaps and guides nobody has verified. Every item links to the web form,
 * prefilled, and to its source file once GitHub contributions are open.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Badge from '../../components/Badge.astro';
import StaleBadge from '../../components/StaleBadge.astro';
import { editUrl, reportProblemUrl, site } from '../../site.config';
import { githubOpen } from '../../lib/github-open';
import { helpWanted } from '../../lib/help-wanted';
import { CHECK_REASONS } from '../../lib/staleness';
import { LINK_CHECKED } from '../../lib/contribution';
import { SYSTEMS } from '../../lib/enums';

const hw = await helpWanted();
const c = hw.counts;
const host = (u: string) => u.replace(/^https?:\/\/(www\.)?/, '').split('/')[0];
const plural = (n: number, one: string, many = `${one}s`) => `${n} ${n === 1 ? one : many}`;
const summary = [
  { href: '#links', n: c.needsCheck, label: `of ${c.total} buy links need a check` },
  { href: '#unknowns', n: c.questions, label: 'unknown values in guides, fixes and vendors' },
  { href: '#specs', n: c.gaps, label: 'specs nobody has found yet' },
  { href: '#guides', n: c.unverifiedGuides, label: 'guides not yet verified on a bike' },
];
---

<BaseLayout
  title="Help wanted"
  description="Buy links to check, unknown values and unverified guides. Pick one and tell us what you found."
  editPath="src/lib/help-wanted.ts"
>
  <div class="wrap">
    <nav class="crumbs" aria-label="Breadcrumb">
      <ol>
        <li>
          <a href="/contribute">contribute</a>
        </li>
        <li aria-current="page">help wanted</li>
      </ol>
    </nav>
    <header class="page-head">
      <h1>Help wanted</h1>
      <p class="lede">
        Everything on this list is something an owner can check in a few minutes. Pick one, look,
        and tell us what you found with the form. No account needed. This page rebuilds from the
        site’s content every time it changes, so it’s always current.
      </p>
    </header>

    <ul class="tally" aria-label="Summary">
      {summary.map((s) => (
        <li>
          <a href={s.href}>
            <span class="n">{s.n}</span>
            <span class="l">{s.label}</span>
          </a>
        </li>
      ))}
    </ul>

    <section class="block" id="links" aria-labelledby="h-links">
      <h2 class="block-title" id="h-links">
        <span class="n">01</span>Buy links to check
      </h2>
      <div class="block-body">
        <p class="intro">
          Open the link, make sure it’s the right part for the Metacycle, and note the price. Then
          tap <strong>I checked this</strong>, choose what you found and add the price. Links count
          as stale {site.staleAfterDays} days after someone last checked them.{' '}
          {c.byHand > 0 && (
            <>
              {plural(c.byHand, 'link')} marked <strong>check by hand</strong> are on stores that
              block the automatic link checker, so only a person can confirm them.
            </>
          )}
        </p>
        <p class="caption counts">
          {c.neverVerified} never verified · {c.stale - c.neverVerified} stale · {c.noPrice} with no
          price · {c.noUrl} with no link · {c.dead} dead · {c.outOfStock} out of stock
        </p>
        {hw.byVendor.length === 0 ? (
          <p>Every buy link has been checked recently. Thank you!</p>
        ) : (
          <>
            <nav class="jump" aria-label="Vendors">
              <ul>
                {hw.byVendor.map((g) => (
                  <li>
                    <a class="text-link" href={`#v-${g.id}`}>
                      {g.name} ({g.items.length})
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
            {hw.byVendor.map((g) => (
              <section class="group" id={`v-${g.id}`} aria-labelledby={`h-v-${g.id}`}>
                <h3 id={`h-v-${g.id}`}>
                  <a href={`/vendors/${g.id}`}>{g.name}</a>
                  <span class="count">{plural(g.items.length, 'link')}</span>
                </h3>
                <ul class="items">
                  {g.items.map((it) => (
                    <li class="item">
                      <div class="what">
                        <a class="name" href={`/parts/${it.part.id}`}>
                          {it.part.data.name}
                        </a>
                        <span class="sub">{it.url === 'TODO' ? 'no link yet' : host(it.url)}</span>
                        <span class="why">
                          {it.reasons.includes('never-verified') || it.reasons.includes('stale') ? (
                            <StaleBadge />
                          ) : null}
                          {it.byHand && <Badge tone="dashed">check by hand</Badge>}
                          <span class="reasons">
                            {it.reasons
                              .filter((r) => !['never-verified', 'stale', 'unverified'].includes(r))
                              .map((r) => CHECK_REASONS[r])
                              .join(' · ')}
                          </span>
                        </span>
                      </div>
                      <div class="acts">
                        {it.url !== 'TODO' && (
                          <a class="btn" href={it.url} rel="nofollow noopener noreferrer">
                            open store
                            <span class="visually-hidden">
                              : {it.part.data.name} at {it.vendorName}
                            </span>
                          </a>
                        )}
                        <a
                          class="btn btn-primary"
                          href={reportProblemUrl({
                            type: 'broken-link',
                            part: it.part.id,
                            system: it.part.data.system,
                            page: `/parts/${it.part.id}`,
                            vendor: it.vendorName,
                            url: it.url === 'TODO' ? undefined : it.url,
                            problem: it.url === 'TODO' ? undefined : LINK_CHECKED,
                            summary:
                              it.url === 'TODO'
                                ? `Found a link: ${it.part.data.name} at ${it.vendorName}`
                                : `Checked: ${it.part.data.name} at ${it.vendorName}`,
                          })}
                        >
                          {it.url === 'TODO' ? 'I found it' : 'I checked this'}
                          <span class="visually-hidden">
                            : {it.part.data.name} at {it.vendorName}
                          </span>
                        </a>
                        {githubOpen && it.file && (
                          <a class="text-link" href={editUrl(it.file)}>
                            edit<span class="visually-hidden"> {it.part.data.name}</span>
                          </a>
                        )}
                      </div>
                    </li>
                  ))}
                </ul>
              </section>
            ))}
          </>
        )}
      </div>
    </section>

    <section class="block" id="unknowns" aria-labelledby="h-unknowns">
      <h2 class="block-title" id="h-unknowns">
        <span class="n">02</span>Unknown values
      </h2>
      <div class="block-body">
        <p class="intro">
          Torque values, times and next steps nobody has documented. If you know one, share it with
          a source or a photo if you can.
        </p>
        {hw.questions.length === 0 ? (
          <p>Nothing unknown right now.</p>
        ) : (
          <ul class="rows">
            {hw.questions.map((q) => (
              <li>
                <a
                  href={reportProblemUrl({
                    type: q.kind === 'vendor' ? 'spec-correction' : 'fix',
                    system: q.system,
                    page: q.page,
                    summary: `${q.pageTitle}: ${q.text}`.slice(0, 120),
                  })}
                >
                  <span class="t">
                    {q.text}
                    <span class="sub">
                      {q.pageTitle}
                      {q.system && ` · ${SYSTEMS[q.system as keyof typeof SYSTEMS].toLowerCase()}`}
                    </span>
                  </span>
                  <span class="meta">i know this</span>
                  <span class="go" aria-hidden="true">
                    →
                  </span>
                </a>
              </li>
            ))}
          </ul>
        )}
        <p class="caption">
          Prices and links are counted under buy links above. Each row opens the form; the page it’s
          about is filled in.
        </p>
      </div>
    </section>

    <section class="block" id="specs" aria-labelledby="h-specs">
      <h2 class="block-title" id="h-specs">
        <span class="n">03</span>Specs not yet known
        <a class="more" href="/specs">
          specs page →
        </a>
      </h2>
      <div class="block-body">
        <p class="intro">
          No source we’ve found gives these. A manual page, a label photo or a measurement with a
          photo all count.
        </p>
        <ul class="rows">
          {hw.gaps.map((g) => (
            <li>
              <a
                href={reportProblemUrl({
                  type: 'spec-correction',
                  page: '/specs',
                  summary: `Spec: ${g}`.slice(0, 120),
                })}
              >
                <span class="t">{g}</span>
                <span class="meta">i know this</span>
                <span class="go" aria-hidden="true">
                  →
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="block" id="guides" aria-labelledby="h-guides">
      <h2 class="block-title" id="h-guides">
        <span class="n">04</span>Guides not yet verified
      </h2>
      <div class="block-body">
        <p class="intro">
          Did one of these on your own bike? Tell us whether the steps worked and what you’d change.
          A guide is marked verified once the editor or a co-maintainer confirms it.
        </p>
        {hw.unverifiedGuides.length === 0 ? (
          <p>Every guide has been verified.</p>
        ) : (
          <ul class="rows">
            {hw.unverifiedGuides.map((g) => (
              <li>
                <a
                  href={reportProblemUrl({
                    type: 'fix',
                    system: g.data.system,
                    page: `/guides/${g.id}`,
                    summary: `I did this: ${g.data.title}`.slice(0, 120),
                  })}
                >
                  <span class="t">
                    {g.data.title}
                    <span class="sub">{SYSTEMS[g.data.system].toLowerCase()}</span>
                  </span>
                  <span class="meta">i did this</span>
                  <span class="go" aria-hidden="true">
                    →
                  </span>
                </a>
              </li>
            ))}
          </ul>
        )}
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .intro {
    margin: 0 0 var(--space-4);
    max-width: var(--measure);
  }
  .counts {
    margin: 0 0 var(--space-4);
  }
  /* Summary: one row per count, number in mono at heading size. */
  .tally {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: var(--border) solid var(--color-rule);
    display: grid;
  }
  .tally li {
    display: flex;
  }
  .tally a {
    flex: 1;
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    min-height: var(--tap-target);
    padding: var(--space-3) var(--space-2);
    border-bottom: var(--border) solid var(--color-rule);
    text-decoration: none;
  }
  .tally a:hover {
    background: var(--color-surface);
  }
  .tally .n {
    font-family: var(--font-mono);
    font-size: var(--text-xl);
    font-weight: 600;
    min-width: 2.5ch;
  }
  .tally .l {
    color: var(--color-text-muted);
  }
  @media (min-width: 60rem) {
    .tally {
      grid-template-columns: repeat(4, 1fr);
      column-gap: var(--space-6);
    }
    .tally a {
      flex-direction: column;
      gap: var(--space-1);
    }
  }
  .jump ul {
    list-style: none;
    margin: 0 0 var(--space-2);
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-5);
  }
  .group {
    padding-top: var(--space-6);
  }
  .group h3 {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    margin: 0 0 var(--space-2);
    font-size: var(--text-base);
  }
  .group .count {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 400;
    color: var(--color-text-muted);
  }
  .items {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: var(--border) solid var(--color-rule);
  }
  /* Same inset as .rows; not one link, so no row hover. */
  .item {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-4);
    padding: var(--space-3) var(--space-2);
    border-bottom: var(--border) solid var(--color-rule);
  }
  .what {
    flex: 1 1 18rem;
    min-width: 0;
  }
  .name {
    font-weight: 500;
  }
  .sub {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    word-break: break-all;
  }
  .why {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-1) var(--space-3);
    margin-top: var(--space-1);
  }
  .reasons {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }
  .acts {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-end;
    gap: var(--space-2) var(--space-3);
  }
  @media (max-width: 34rem) {
    .acts {
      flex-basis: 100%;
      justify-content: flex-start;
    }
    .acts .btn {
      flex: 1;
      padding: 0 var(--space-3);
      white-space: nowrap;
    }
  }
</style>
