---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Labeled from '../../components/Labeled.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { YES_NO_UNKNOWN } from '../../lib/enums';
import { partsFromVendor, repoPath } from '../../lib/content';

export async function getStaticPaths() {
  return (await getCollection('vendors')).map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}
const { entry } = Astro.props as { entry: CollectionEntry<'vendors'> };
const d = entry.data;
const parts = await partsFromVendor(entry.id);
---

<BaseLayout title={d.name} editPath={repoPath(entry)} sources={d.references}>
  <h1>{d.name}</h1>
  <Labeled items={[
    ['Website', d.url],
    ['Ships from', d.country],
    ['Ships to US', YES_NO_UNKNOWN[d.ships_to_us]],
    ['US warehouse', YES_NO_UNKNOWN[d.us_warehouse]],
    ['Languages', d.languages.join(', ')],
  ]} />
  {d.buying_tips && (<><h2>Buying tips</h2><p>{d.buying_tips}</p></>)}
  <h2>Parts from this vendor</h2>
  {parts.length ? <ul>{parts.map((p) => <li><a href={`/parts/${p.id}`}>{p.data.name}</a></li>)}</ul> : <p class="muted">None yet.</p>}
</BaseLayout>
