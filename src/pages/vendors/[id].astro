---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { YES_NO_UNKNOWN } from '../../lib/enums';
import { partsFromVendor, repoPath } from '../../lib/content';
import PartCard from '../../components/PartCard.astro';

export async function getStaticPaths() {
  return (await getCollection('vendors')).map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}
const { entry } = Astro.props as { entry: CollectionEntry<'vendors'> };
const d = entry.data;
const parts = (await partsFromVendor(entry.id)).sort((a, b) =>
  a.data.name.localeCompare(b.data.name),
);
const yn = (v: keyof typeof YES_NO_UNKNOWN) => YES_NO_UNKNOWN[v].toLowerCase();
---

<BaseLayout
  title={d.name}
  description={`Buying Metacycle parts from ${d.name}: shipping, US warehouse and tips.`}
  editPath={repoPath(entry)}
  sources={d.references}
>
  <div class="wrap">
    <nav class="crumbs" aria-label="Breadcrumb">
      <ol>
        <li>
          <a href="/vendors">vendors</a>
        </li>
        <li aria-current="page">{entry.id}</li>
      </ol>
    </nav>

    <header class="page-head">
      <p class="label kicker">vendor</p>
      <h1>{d.name}</h1>
      <dl class="kv">
        <div>
          <dt>ships from</dt>
          <dd>{d.country?.toLowerCase() ?? <span class="todo">unknown</span>}</dd>
        </div>
        <div>
          <dt>ships to US</dt>
          <dd>{yn(d.ships_to_us)}</dd>
        </div>
        <div>
          <dt>US warehouse</dt>
          <dd>{yn(d.us_warehouse)}</dd>
        </div>
        <div>
          <dt>languages</dt>
          <dd>{d.languages.length ? d.languages.join(', ') : <span class="todo">unknown</span>}</dd>
        </div>
      </dl>
      <p class="site-link">
        {d.url === 'TODO' ? (
          <span class="btn" aria-disabled="true">
            store link not added yet
          </span>
        ) : (
          <a class="btn btn-primary" href={d.url} rel="nofollow noopener noreferrer">
            visit store ↗
          </a>
        )}
      </p>
    </header>

    <div class="layout">
      <div>
        <section class="block" aria-labelledby="h-parts">
          <h2 class="block-title" id="h-parts">
            <span class="n">01</span>Parts from this vendor
          </h2>
          {parts.length ? (
            parts.map((p) => <PartCard part={p} />)
          ) : (
            <p class="muted none">None yet.</p>
          )}
        </section>
      </div>
      <aside class="side" aria-label="Buying tips">
        <section>
          <h2>Buying tips</h2>
          {d.buying_tips ? <p>{d.buying_tips}</p> : <p class="muted">None yet.</p>}
        </section>
      </aside>
    </div>
  </div>
</BaseLayout>

<style>
  .kicker {
    margin: 0 0 var(--space-2);
  }
  .site-link {
    margin: var(--space-6) 0 0;
  }
  .none {
    padding-top: var(--space-4);
  }
</style>
