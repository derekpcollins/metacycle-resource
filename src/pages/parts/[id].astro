---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { FAILURE_RATES, SYSTEMS } from '../../lib/enums';
import { guidesForPart, repoPath } from '../../lib/content';
import { isoDate, latestVerified } from '../../lib/format';
import BuyOptions from '../../components/BuyOptions.astro';
import SpecsTable from '../../components/SpecsTable.astro';
import SystemChip from '../../components/SystemChip.astro';
import DifficultyMeter from '../../components/DifficultyMeter.astro';
import { reportProblemUrl } from '../../site.config';

export async function getStaticPaths() {
  return (await getCollection('parts')).map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}
const { entry } = Astro.props as { entry: CollectionEntry<'parts'> };
const d = entry.data;
const guides = await guidesForPart(entry);
const verified = latestVerified(d.sources);
const hasSpecs = Object.keys(d.specs).length > 0;
let n = 1;
const num = () => String(n++).padStart(2, '0');
---

<BaseLayout
  contributors={d.contributors}
  title={d.name}
  description={`${d.name}: specs, where to buy, and fit notes for the Sondors Metacycle.`}
  editPath={repoPath(entry)}
  report={{ part: entry.id, system: d.system }}
  sources={d.references}
  lastVerified={verified ? isoDate(verified) : 'never'}
>
  <article class="wrap" data-pagefind-body data-pagefind-filter="type:Part">
    <nav class="crumbs" aria-label="Breadcrumb" data-pagefind-ignore>
      <ol>
        <li>
          <a href="/parts">parts</a>
        </li>
        <li>
          <a href={`/parts?system=${d.system}`}>{SYSTEMS[d.system].toLowerCase()}</a>
        </li>
        <li aria-current="page">{entry.id}</li>
      </ol>
    </nav>

    <header class="page-head">
      <h1 data-pagefind-meta="title">{d.name}</h1>
      {d.aliases.length > 0 && (
        <p class="lede" data-pagefind-weight="6">
          Also called {d.aliases.join(', ')}.
        </p>
      )}
      <dl class="kv" data-pagefind-ignore>
        <div>
          <dt>system</dt>
          <dd>
            <SystemChip system={d.system} link />
          </dd>
        </div>
        {d.oem_part_number && (
          <div>
            <dt>part no.</dt>
            <dd>{d.oem_part_number}</dd>
          </div>
        )}
        {d.failure_rate && (
          <div>
            <dt>failure rate</dt>
            <dd>{FAILURE_RATES[d.failure_rate].toLowerCase()}</dd>
          </div>
        )}
        {d.difficulty && (
          <div>
            <dt>difficulty</dt>
            <dd>
              <DifficultyMeter value={d.difficulty} />
            </dd>
          </div>
        )}
        {d.diagram_ref && (
          <div>
            <dt>diagram</dt>
            <dd>#{d.diagram_ref}</dd>
          </div>
        )}
      </dl>
      {d.photo && (
        <figure class="photo" data-pagefind-ignore>
          <img src={d.photo} alt={d.photo_alt} loading="lazy" decoding="async" />
          {d.photo_credit && <figcaption class="label">photo: {d.photo_credit}</figcaption>}
        </figure>
      )}
    </header>

    <section class="block" aria-labelledby="h-buy">
      <h2 class="block-title" id="h-buy">
        <span class="n" data-pagefind-ignore>
          {num()}
        </span>
        Where to buy
      </h2>
      <div data-pagefind-ignore>
        <BuyOptions part={entry} />
      </div>
    </section>

    <div class="layout">
      <div>
        {hasSpecs && (
          <section class="block" aria-labelledby="h-specs">
            <h2 class="block-title" id="h-specs">
              <span class="n" data-pagefind-ignore>
                {num()}
              </span>
              Specs
            </h2>
            <SpecsTable specs={d.specs} caption={`${d.name} specs`} />
          </section>
        )}
        {d.fits_notes && (
          <section class="block" aria-labelledby="h-fit">
            <h2 class="block-title" id="h-fit">
              <span class="n" data-pagefind-ignore>
                {num()}
              </span>
              Fit notes
            </h2>
            <p class="note">{d.fits_notes}</p>
          </section>
        )}
      </div>

      <aside class="side" aria-label="Related">
        <section>
          <h2>Related guides</h2>
          {guides.length ? (
            <ul>
              {guides.map((g) => (
                <li>
                  <a href={`/guides/${g.id}`}>{g.data.title}</a>
                </li>
              ))}
            </ul>
          ) : (
            <p class="muted">
              None yet.{' '}
              <a href={reportProblemUrl({ type: 'fix', part: entry.id, system: d.system })}>
                Share a fix
              </a>
              .
            </p>
          )}
        </section>
      </aside>
    </div>
  </article>
</BaseLayout>

<style>
  .photo {
    margin: var(--space-6) 0 0;
    max-width: 36rem;
  }
  .photo img {
    display: block;
    width: 100%;
    height: auto;
    border: var(--border) solid var(--color-rule);
  }
  .photo figcaption {
    margin-top: var(--space-2);
  }
  .note {
    white-space: pre-line;
    padding: var(--space-4) 0 0;
    margin: 0;
    max-width: 60ch;
  }
  .side a {
    display: inline-block;
    padding: var(--space-1) 0;
  }
</style>
