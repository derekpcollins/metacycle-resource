---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site, reportProblemUrl } from '../site.config';
---

<BaseLayout title="Contribute" editPath="src/pages/contribute.astro">
  <div class="wrap">
    <header class="page-head">
      <h1>Contribute</h1>
      <p class="lede">
        Fixes, parts, working buy links and photos all help. Every change is reviewed before it goes
        live.
      </p>
    </header>
    <div class="prose">
      <h2>Today</h2>
      <ul>
        <li>
          <a href={reportProblemUrl()}>Report a problem</a> or suggest a change on GitHub (needs a
          GitHub account).
        </li>
        <li>
          Comfortable with GitHub? Every page has an <strong>edit this page</strong> link, or browse
          the <a href={site.repoUrl}>source files</a>.
        </li>
      </ul>
      <h2>Coming soon</h2>
      <p>
        A short form for owners without a GitHub account, a Help Wanted list of links that need
        checking, and a changelog of what’s new.
      </p>
    </div>
  </div>
</BaseLayout>
