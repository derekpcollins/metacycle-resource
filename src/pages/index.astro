---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { site } from '../site.config';
import { SYSTEMS, keys } from '../lib/enums';
import { isoDate, latestVerified } from '../lib/format';
import { community } from '../data/community';
import SearchBox from '../components/SearchBox.astro';
import SymptomShortcuts from '../components/SymptomShortcuts.astro';
import PartCard from '../components/PartCard.astro';
import EmptyState from '../components/EmptyState.astro';

const [symptoms, parts] = await Promise.all([
  getCollection('troubleshooting'),
  getCollection('parts'),
]);
symptoms.sort((a, b) => a.data.symptom.localeCompare(b.data.symptom));

const systemCounts = keys(SYSTEMS).map((s) => ({
  id: s,
  label: SYSTEMS[s].toLowerCase(),
  count: parts.filter((p) => p.data.system === s).length,
}));

const recentlyVerified = parts
  .map((p) => ({ p, d: latestVerified(p.data.sources) }))
  .filter((x): x is { p: (typeof parts)[number]; d: Date } => x.d !== undefined)
  .sort((a, b) => b.d.getTime() - a.d.getTime())
  .slice(0, 5);
---

<BaseLayout title={site.name} editPath="src/pages/index.astro">
  <section class="hero">
    <div class="wrap">
      <h1 class="visually-hidden">{site.name}</h1>
      <SearchBox id="home-search" />
      <p class="hint label">try: absorber · won’t power on · battery removal</p>
    </div>
  </section>

  <div class="wrap sections">
    <section class="block" aria-labelledby="h-symptoms">
      <h2 class="block-title" id="h-symptoms">
        <span class="n">01</span>What’s wrong?
        <a class="more" href="/troubleshooting">
          all symptoms →
        </a>
      </h2>
      <SymptomShortcuts entries={symptoms} />
    </section>

    <section class="block" aria-labelledby="h-systems">
      <h2 class="block-title" id="h-systems">
        <span class="n">02</span>Browse by system
      </h2>
      <ul class="systems">
        {systemCounts.map((s) => (
          <li>
            <a href={`/parts?system=${s.id}`}>
              <span>{s.label}</span>
              <span class="c">
                {s.count}
                <span class="visually-hidden">{s.count === 1 ? 'part' : 'parts'}</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
      <p class="caption">number = parts listed</p>
    </section>

    <div class="two-col">
      <section class="block" aria-labelledby="h-verified">
        <h2 class="block-title" id="h-verified">
          <span class="n">03</span>Recently verified
        </h2>
        {recentlyVerified.length > 0 ? (
          <div>
            {recentlyVerified.map(({ p, d }) => (
              <div>
                <PartCard part={p} />
                <span class="visually-hidden">verified {isoDate(d)}</span>
              </div>
            ))}
          </div>
        ) : (
          <EmptyState title="no buy links verified yet">
            <p>
              Every link is checked and dated. Found one that works?{' '}
              <a href="/contribute">Help verify it</a>.
            </p>
          </EmptyState>
        )}
      </section>

      <section class="block" aria-labelledby="h-community">
        <h2 class="block-title" id="h-community">
          <span class="n">04</span>Community
          <a class="more" href="/community">
            all groups →
          </a>
        </h2>
        <ul class="community">
          {community.map((c) => (
            <li>
              <a href={c.url ?? '/community'}>
                <span class="ext">{c.name}</span>
                <span class="k">
                  {c.kind}
                  {c.note && ` · ${c.note}`}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  .hero {
    padding: var(--space-6) 0 0;
  }
  .hint {
    margin: var(--space-3) 0 0;
  }
  .sections .block {
    padding-top: var(--space-10);
  }
  .sections .block:first-child {
    padding-top: var(--space-8);
  }
  .systems {
    list-style: none;
    margin: 0;
    padding: 0;
    columns: 2;
    column-gap: var(--space-6);
  }
  .systems li {
    break-inside: avoid;
  }
  .systems a {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--tap-target);
    padding: var(--space-1) 0;
    border-bottom: var(--border) solid var(--color-rule);
    text-decoration: none;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    line-height: 1.3;
  }
  .systems a:hover span:first-child {
    text-decoration: underline;
  }
  .systems .c {
    color: var(--color-text-muted);
    font-size: var(--text-xs);
  }
  .community {
    list-style: none;
    margin: 0;
    padding: 0;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }
  .community li {
    display: flex;
    align-items: center;
    min-height: var(--tap-target);
    border-bottom: var(--border) solid var(--color-rule);
  }
  .community a {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    min-height: var(--tap-target);
    text-decoration: none;
  }
  .community a:hover .ext {
    text-decoration: underline;
  }
  .community .k {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    white-space: nowrap;
  }
  @media (min-width: 60rem) {
    .hero {
      padding: var(--space-12) 0 0;
    }
    .systems {
      columns: 3;
    }
    .two-col {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--space-10);
    }
  }
</style>
