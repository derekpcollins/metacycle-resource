---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { site } from '../site.config';
import { SYSTEMS, keys } from '../lib/enums';
import { community } from '../data/community';
import SearchBox from '../components/SearchBox.astro';
import SymptomShortcuts from '../components/SymptomShortcuts.astro';

const [symptoms, parts] = await Promise.all([
  getCollection('troubleshooting'),
  getCollection('parts'),
]);
symptoms.sort((a, b) => a.data.symptom.localeCompare(b.data.symptom));

const systemCounts = keys(SYSTEMS).map((s) => ({
  id: s,
  label: SYSTEMS[s].toLowerCase(),
  count: parts.filter((p) => p.data.system === s).length,
}));
---

<BaseLayout title={site.name} editPath="src/pages/index.astro">
  <section class="hero">
    <div class="wrap">
      <h1 class="visually-hidden">{site.name}</h1>
      <SearchBox id="home-search" />
      <p class="hint label">try: absorber · won’t power on · battery removal</p>
    </div>
  </section>

  <div class="wrap sections">
    <section class="block" aria-labelledby="h-symptoms">
      <h2 class="block-title" id="h-symptoms">
        <span class="n">01</span>What’s wrong?
        <a class="more" href="/troubleshooting">
          all symptoms →
        </a>
      </h2>
      <SymptomShortcuts entries={symptoms} />
    </section>

    <section class="block" aria-labelledby="h-systems">
      <h2 class="block-title" id="h-systems">
        <span class="n">02</span>Browse by system
      </h2>
      <ul class="systems">
        {systemCounts.map((s) => (
          <li>
            <a href={`/parts?system=${s.id}`}>
              <span>{s.label}</span>
              <span class="c">
                {s.count}
                <span class="visually-hidden">{s.count === 1 ? 'part' : 'parts'}</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
      <p class="caption">number = parts listed</p>
    </section>

    <section class="block" aria-labelledby="h-community">
      <h2 class="block-title" id="h-community">
        <span class="n">03</span>Community
        <a class="more" href="/community">
          all groups →
        </a>
      </h2>
      <ul class="community">
        {community.map((c) => (
          <li>
            <a href={c.url ?? '/community'}>
              <span class="ext">{c.name}</span>
              <span class="k">
                {c.kind}
                {c.note && ` · ${c.note}`}
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  </div>
</BaseLayout>

<style>
  .hero {
    padding: var(--space-6) 0 0;
  }
  .hint {
    margin: var(--space-3) 0 0;
  }
  .sections .block {
    padding-top: var(--space-10);
  }
  .sections .block:first-child {
    padding-top: var(--space-8);
  }
  /* Row lists: the whole row takes the surface colour on hover, like .rows. */
  .systems a,
  .community a {
    padding-left: var(--space-2);
    padding-right: var(--space-2);
  }
  /* Room above and below when a long name wraps. */
  .community a {
    padding-top: var(--space-2);
    padding-bottom: var(--space-2);
    line-height: 1.4;
  }
  .systems a:hover,
  .community a:hover {
    background: var(--color-surface);
  }
  .systems {
    list-style: none;
    margin: 0;
    padding: 0;
    columns: 2;
    column-gap: var(--space-6);
  }
  .systems li {
    break-inside: avoid;
  }
  .systems a {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--tap-target);
    padding-top: var(--space-1);
    padding-bottom: var(--space-1);
    border-bottom: var(--border) solid var(--color-rule);
    text-decoration: none;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    line-height: 1.3;
  }
  .systems .c {
    color: var(--color-text-muted);
    font-size: var(--text-xs);
  }
  .community {
    columns: 1;
    column-gap: var(--space-6);
    list-style: none;
    margin: 0;
    padding: 0;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }
  .community li {
    break-inside: avoid;
    display: flex;
    align-items: center;
    min-height: var(--tap-target);
    border-bottom: var(--border) solid var(--color-rule);
  }
  .community a {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    min-height: var(--tap-target);
    text-decoration: none;
  }
  .community .k {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    white-space: nowrap;
  }
  @media (min-width: 60rem) {
    .hero {
      padding: var(--space-12) 0 0;
    }
    .systems {
      columns: 3;
    }
    .community {
      columns: 2;
    }
  }
</style>
