---
/** Every page ends with: sources, last verified, Edit this page, Report a problem (spec). */
import { editUrl, reportProblemUrl } from '../site.config';

interface Props {
  title: string;
  sources?: string[];
  /** ISO date, 'never', or undefined to hide the line. */
  lastVerified?: string;
  editPath?: string;
}
const { title, sources = [], lastVerified, editPath } = Astro.props;
const display = (u: string) => u.replace(/^https?:\/\/(www\.)?/, '');
---

<aside class="page-meta" aria-label="About this page">
  <div class="wrap grid">
    {sources.length > 0 && <h2 class="label head">sources</h2>}
    <div class="srcs">
      {sources.length > 0 && (
        <ol>
          {sources.map((s) => (
            <li>
              <a href={s}>{display(s)}</a>
            </li>
          ))}
        </ol>
      )}
      {lastVerified && <p class="label lv">last verified: {lastVerified}</p>}
    </div>
    <ul class="acts">
      <li>
        {editPath ? (
          <a class="text-link" href={editUrl(editPath)}>
            edit this page
          </a>
        ) : (
          <span class="text-link muted">edit this page (coming soon)</span>
        )}
      </li>
      <li>
        <a class="text-link" href={reportProblemUrl(title)}>
          report a problem
        </a>
      </li>
    </ul>
  </div>
</aside>

<style>
  .page-meta {
    margin-top: var(--space-12);
    border-top: var(--border) solid var(--color-rule);
    padding: var(--space-6) 0;
  }
  .grid {
    display: grid;
    gap: 0 var(--space-6);
  }
  .head {
    font-weight: 400;
    letter-spacing: 0.02em;
    margin: 0;
  }
  ol {
    margin: var(--space-2) 0 0;
    padding-left: 1.6em;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    word-break: break-word;
  }
  ol li {
    padding: var(--space-2) 0;
  }
  .lv {
    margin: var(--space-3) 0 0;
  }
  .acts {
    list-style: none;
    margin: var(--space-4) 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-6);
  }
  @media (min-width: 60rem) {
    /* Row 1: "sources" label. Row 2: source list beside the actions, sharing a baseline
       so the links line up with the first source. */
    .grid {
      grid-template-columns: 2fr 1fr;
      align-items: baseline;
    }
    .head {
      grid-column: 1;
    }
    .srcs {
      grid-column: 1;
      grid-row: 2;
    }
    .acts {
      grid-column: 2;
      grid-row: 2;
      justify-content: flex-end;
      margin-top: 0;
    }
  }
</style>
