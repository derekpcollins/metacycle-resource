---
/** Every page ends with: sources, last verified, Edit this page, Report a problem (spec). */
import { editUrl, reportProblemUrl } from '../site.config';

interface Props {
  title: string;
  sources?: string[];
  /** ISO date, 'never', or undefined to hide the line. */
  lastVerified?: string;
  editPath?: string;
}
const { title, sources = [], lastVerified, editPath } = Astro.props;
const display = (u: string) => u.replace(/^https?:\/\/(www\.)?/, '');
---

<aside class="page-meta" aria-label="About this page">
  <div class="wrap grid">
    <div>
      {sources.length > 0 && (
        <>
          <h2 class="label">sources</h2>
          <ol>
            {sources.map((s) => (
              <li>
                <a href={s}>{display(s)}</a>
              </li>
            ))}
          </ol>
        </>
      )}
      {lastVerified && <p class="label lv">last verified: {lastVerified}</p>}
    </div>
    <ul class="acts">
      <li>
        {editPath ? (
          <a class="text-link" href={editUrl(editPath)}>
            edit this page
          </a>
        ) : (
          <span class="text-link muted">edit this page (coming soon)</span>
        )}
      </li>
      <li>
        <a class="text-link" href={reportProblemUrl(title)}>
          report a problem
        </a>
      </li>
    </ul>
  </div>
</aside>

<style>
  .page-meta {
    margin-top: var(--space-12);
    border-top: var(--border) solid var(--color-rule);
    padding: var(--space-6) 0;
  }
  .grid {
    display: grid;
    gap: var(--space-4);
  }
  h2 {
    font-weight: 400;
    letter-spacing: 0.02em;
  }
  ol {
    margin: var(--space-2) 0 0;
    padding-left: 1.6em;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    word-break: break-word;
  }
  li {
    padding: 2px 0;
  }
  ol a {
    display: inline-block;
    padding: var(--space-2) 0;
  }
  .lv {
    margin: var(--space-3) 0 0;
  }
  .acts {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  @media (min-width: 60rem) {
    .grid {
      grid-template-columns: 2fr 1fr;
    }
    .acts {
      align-items: flex-end;
    }
  }
</style>
