---
/**
 * Small mono label. Tones:
 *  - ok / warn / bad / off: status (coloured text + dot; off = hollow dot)
 *  - outline: solid box (e.g. "confirmed", fit, type)
 *  - dashed: dashed box (e.g. "community-reported")
 *  - flag: yellow fill — "needs re-check" only
 */
interface Props {
  tone?: 'ok' | 'warn' | 'bad' | 'off' | 'outline' | 'dashed' | 'flag' | 'plain';
  title?: string;
}
const { tone = 'plain', title } = Astro.props;
---

<span class:list={['badge', tone]} title={title}>
  <slot />
</span>

<style>
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 600;
    line-height: 1.5;
    white-space: nowrap;
  }
  .ok,
  .warn,
  .bad,
  .off {
    font-weight: 600;
  }
  .ok::before,
  .warn::before,
  .bad::before,
  .off::before {
    content: '';
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: currentColor;
    flex: none;
  }
  .ok {
    color: var(--color-ok);
  }
  .warn {
    color: var(--color-warn);
  }
  .bad {
    color: var(--color-bad);
  }
  .off {
    color: var(--color-off);
  }
  .off::before {
    background: transparent;
    box-shadow: inset 0 0 0 1.5px currentColor;
  }
  .outline,
  .dashed {
    font-weight: 400;
    border: var(--border) solid var(--color-rule-strong);
    padding: 0 6px;
  }
  .dashed {
    border-style: dashed;
  }
  .flag {
    background: var(--color-accent);
    color: var(--color-on-accent);
    padding: 0 6px;
  }
  .plain {
    font-weight: 400;
  }
</style>
