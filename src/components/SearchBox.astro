---
/**
 * Search form. Submits to /search (GET ?q=), where Pagefind runs. Works without JS as a
 * plain form; the results page needs JS (Pagefind is client-side).
 */
interface Props {
  id?: string;
  value?: string;
  placeholder?: string;
}
const { id = 'site-search', value = '', placeholder = 'part or symptom' } = Astro.props;
---

<form class="search" role="search" action="/search" method="get">
  <label for={id} class="visually-hidden">
    Search parts, guides and symptoms
  </label>
  <span class="prompt" aria-hidden="true">
    &gt;
  </span>
  <input
    id={id}
    name="q"
    type="search"
    value={value}
    placeholder={placeholder}
    autocomplete="off"
    enterkeyhint="search"
  />
  <button type="submit" class="go">
    search
  </button>
</form>

<style>
  .search {
    display: flex;
    align-items: center;
    border: var(--border) solid var(--color-rule-strong);
    background: var(--color-bg);
  }
  .search:focus-within {
    box-shadow:
      0 0 0 1px var(--focus-ring),
      0 0 0 5px var(--focus-halo);
  }
  .prompt {
    font-family: var(--font-mono);
    padding-left: var(--space-4);
    color: var(--color-text-muted);
  }
  input {
    flex: 1;
    min-width: 0;
    min-height: 56px;
    padding: 0 var(--space-3);
    border: 0;
    background: transparent;
    color: var(--color-text);
    font-family: var(--font-mono);
    font-size: var(--text-base);
  }
  input:focus {
    outline: none;
    box-shadow: none;
  }
  input::placeholder {
    color: var(--color-text-muted);
    opacity: 1;
  }
  .go {
    align-self: stretch;
    min-width: var(--tap-target);
    padding: 0 var(--space-4);
    border: 0;
    border-left: var(--border) solid var(--color-rule-strong);
    background: transparent;
    color: var(--color-text);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 600;
    cursor: pointer;
  }
  .go:hover {
    background: var(--color-accent);
    color: var(--color-on-accent);
  }
  .go:focus-visible {
    outline-offset: -4px;
    box-shadow: none;
  }
</style>
