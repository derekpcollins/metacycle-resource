---
/** 1–5 wrench scale. */
interface Props {
  value: 1 | 2 | 3 | 4 | 5;
}
const { value } = Astro.props;
---

<span class="meter" role="img" aria-label={`Difficulty ${value} of 5`}>
  <span class="on" aria-hidden="true">
    {'■'.repeat(value)}
  </span>
  <span class="off" aria-hidden="true">
    {'■'.repeat(5 - value)}
  </span>
  <span class="n" aria-hidden="true">
    {value}/5
  </span>
</span>

<style>
  .meter {
    font-family: var(--font-mono);
    letter-spacing: 1px;
    white-space: nowrap;
  }
  .off {
    color: var(--color-rule);
  }
  .n {
    margin-left: 0.6em;
    letter-spacing: 0;
  }
</style>
