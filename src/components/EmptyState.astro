---
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<div class="empty">
  <p class="label">{title}</p>
  <div class="body">
    <slot />
  </div>
</div>

<style>
  .empty {
    padding: var(--space-5) 0;
    border-bottom: var(--border) solid var(--color-rule);
  }
  .label {
    margin: 0 0 var(--space-1);
  }
  .body :global(p) {
    margin: 0;
  }
</style>
