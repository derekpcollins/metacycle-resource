---
/**
 * Buy-options table (spec → Part detail). Stacked rows on phones, a table on desktop.
 * Rows never verified, or verified longer ago than site.staleAfterDays, are greyed
 * (not faded — opacity would break AA contrast) and flagged "needs re-check".
 */
import { getEntry, type CollectionEntry } from 'astro:content';
import { reportProblemUrl, site } from '../site.config';
import { FITS, SOURCE_STATUSES, SOURCE_TYPES } from '../lib/enums';
import { formatPrice, isoDate, sourceIsStale, statusTone } from '../lib/format';
import Badge from './Badge.astro';
import StaleBadge from './StaleBadge.astro';

interface Props {
  part: CollectionEntry<'parts'>;
}
const { part } = Astro.props;
const rows = await Promise.all(
  part.data.sources.map(async (s) => ({ s, vendor: await getEntry(s.vendor) })),
);
---

{rows.length === 0 ? (
  <p class="muted">No buy options known yet.</p>
) : (
  <>
    <table class="buy">
      <caption class="visually-hidden">Where to buy {part.data.name}</caption>
      <thead>
        <tr>
          <th scope="col">vendor</th>
          <th scope="col">type</th>
          <th scope="col">fit</th>
          <th scope="col">price</th>
          <th scope="col">status</th>
          <th scope="col">verified</th>
          <th scope="col">
            <span class="visually-hidden">actions</span>
          </th>
        </tr>
      </thead>
      <tbody>
        {rows.map(({ s, vendor }) => {
          const stale = sourceIsStale(s);
          const price = formatPrice(s.price);
          const vendorName = vendor?.data.name ?? s.vendor.id;
          return (
            <tr class:list={[{ 'is-stale': stale }]}>
              <td class="vendor">
                <a href={`/vendors/${s.vendor.id}`}>{vendorName}</a>
                {vendor?.data.country && <span class="from">ships from {vendor.data.country}</span>}
                {s.notes && <span class="from">{s.notes}</span>}
              </td>
              <td data-k="type">{SOURCE_TYPES[s.type]}</td>
              <td data-k="fit">{FITS[s.fit].toLowerCase()}</td>
              <td data-k="price">{price ?? <span class="todo">not checked</span>}</td>
              <td data-k="status">
                <Badge tone={statusTone(s.status)}>{SOURCE_STATUSES[s.status].toLowerCase()}</Badge>
              </td>
              <td data-k="verified">
                {s.last_verified instanceof Date && (
                  <span class="date">{isoDate(s.last_verified)}</span>
                )}
                {stale && <StaleBadge />}
              </td>
              <td class="actions">
                {s.url === 'TODO' ? (
                  <span class="btn" aria-disabled="true">
                    no link yet
                  </span>
                ) : (
                  <a class="btn btn-primary" href={s.url} rel="nofollow noopener noreferrer">
                    open store<span class="visually-hidden">: {vendorName}</span>
                  </a>
                )}
                <a
                  class="text-link"
                  href={reportProblemUrl({
                    type: 'broken-link',
                    part: part.id,
                    system: part.data.system,
                    vendor: vendorName,
                    url: s.url === 'TODO' ? undefined : s.url,
                    page: `/parts/${part.id}`,
                  })}
                >
                  report broken link<span class="visually-hidden"> for {vendorName}</span>
                </a>
              </td>
            </tr>
          );
        })}
      </tbody>
    </table>
    <p class="caption">
      Prices are as last seen. Rows not verified in the last {site.staleAfterDays} days are greyed
      and flagged.
    </p>
  </>
)}

<style>
  .buy thead {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }
  .buy tr {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-2) var(--space-4);
    padding: var(--space-4) 0;
    border-bottom: var(--border) solid var(--color-rule);
  }
  .buy td {
    display: block;
    padding: 0;
    font-size: var(--text-sm);
  }
  .buy td[data-k]::before {
    content: attr(data-k);
    display: block;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }
  .vendor {
    grid-column: 1 / -1;
    font-weight: 600;
    font-size: var(--text-base) !important;
  }
  .vendor a {
    display: inline-block;
    padding: var(--space-1) 0;
  }
  .from {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 400;
    color: var(--color-text-muted);
  }
  .date {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    margin-right: var(--space-2);
  }
  [data-k='verified'] {
    display: flex !important;
    flex-wrap: wrap;
    gap: var(--space-1);
    align-items: center;
  }
  [data-k='verified']::before {
    flex-basis: 100%;
  }
  .actions {
    grid-column: 1 / -1;
    display: flex !important;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    align-items: center;
    margin-top: var(--space-2);
  }
  .is-stale td:not(.actions) {
    color: var(--color-text-muted);
  }
  .is-stale .vendor a {
    text-decoration-style: dashed;
  }
  @media (min-width: 60rem) {
    .buy thead {
      position: static;
      width: auto;
      height: auto;
      overflow: visible;
      clip: auto;
      display: table-header-group;
    }
    .buy tr {
      display: table-row;
    }
    .buy th,
    .buy td {
      display: table-cell;
      padding: var(--space-4) var(--space-4) var(--space-4) 0;
      border-bottom: var(--border) solid var(--color-rule);
      text-align: left;
      vertical-align: middle;
    }
    .buy th {
      font-family: var(--font-mono);
      font-size: var(--text-xs);
      font-weight: 400;
      color: var(--color-text-muted);
      padding-top: var(--space-3);
      padding-bottom: var(--space-3);
    }
    .buy td[data-k]::before {
      display: none;
    }
    .vendor {
      min-width: 16ch;
    }
    [data-k='verified'],
    .actions {
      display: table-cell !important;
    }
    .actions {
      margin: 0;
      text-align: right;
    }
    .actions .btn {
      white-space: nowrap;
    }
    .actions .text-link {
      display: flex;
      justify-content: flex-end;
      min-height: 2.75rem;
      white-space: nowrap;
    }
    [data-k='price'] {
      white-space: nowrap;
    }
  }
</style>
