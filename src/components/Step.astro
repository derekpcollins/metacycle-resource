---
/**
 * Guide step card (spec: number, text, optional photo, optional torque value).
 * The "done" checkbox makes steps checkable on a phone; guide pages remember ticks per
 * device (localStorage) when JS is available. Without JS the checkbox still works.
 */
interface Props {
  n: number;
  photo?: string;
  photoAlt?: string;
  torque?: string;
}
const { n, photo, photoAlt = '', torque } = Astro.props;
const id = `step-${n}`;
---

<section class="step" aria-labelledby={`${id}-h`} data-step={n}>
  <div class="head">
    <h3 id={`${id}-h`} class="num">
      step {String(n).padStart(2, '0')}
    </h3>
    <label class="done">
      <input type="checkbox" data-step-check={n} />
      <span>done</span>
    </label>
  </div>
  <div class="body">
    <slot />
  </div>
  {torque && (
    <p class="torque">
      <span class="k">torque</span> <span class="v">{torque}</span>
    </p>
  )}
  {photo && (
    <figure>
      <img src={photo} alt={photoAlt} loading="lazy" decoding="async" />
    </figure>
  )}
</section>

<style>
  .step {
    border-top: var(--border) solid var(--color-rule-strong);
    padding: var(--space-3) 0 var(--space-6);
  }
  .head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }
  .num {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--color-text-muted);
  }
  .done {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--tap-target);
    min-width: var(--tap-target);
    justify-content: flex-end;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    cursor: pointer;
  }
  .done input {
    width: 24px;
    height: 24px;
    margin: 0;
    accent-color: var(--color-text);
    cursor: pointer;
  }
  .body {
    max-width: var(--measure);
    font-size: var(--text-lg);
  }
  .body :global(p) {
    margin: 0 0 var(--space-3);
  }
  .body :global(p:last-child) {
    margin-bottom: 0;
  }
  .torque {
    display: inline-flex;
    gap: var(--space-3);
    margin: var(--space-3) 0 0;
    padding: var(--space-2) var(--space-3);
    border: var(--border) solid var(--color-rule-strong);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }
  .torque .k {
    color: var(--color-text-muted);
  }
  .torque .v {
    font-weight: 600;
  }
  figure {
    margin: var(--space-4) 0 0;
  }
  img {
    display: block;
    border: var(--border) solid var(--color-rule);
  }
  .step:has(input:checked) .body,
  .step:has(input:checked) .torque {
    color: var(--color-text-muted);
  }
  .step:has(input:checked) .num {
    text-decoration: line-through;
  }
</style>
