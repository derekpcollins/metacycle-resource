---
/**
 * Guide step card (spec: number, text, optional photo, optional torque value).
 * Same check pattern as the tools checklist: an unlabeled checkbox on the left (its
 * accessible name is "Step N done"), content on the right. Guide pages remember ticks
 * per device (localStorage) when JS is available. Without JS the checkbox still works.
 */
interface Props {
  n: number;
  photo?: string;
  photoAlt?: string;
  torque?: string;
}
const { n, photo, photoAlt = '', torque } = Astro.props;
const id = `step-${n}`;
const label = `step ${String(n).padStart(2, '0')}`;
---

<section class="step" aria-labelledby={`${id}-h`} data-step={n}>
  <input
    type="checkbox"
    class="check"
    id={`${id}-done`}
    data-step-check={n}
    aria-label={`Step ${n} done`}
  />
  <div class="content">
    <h3 id={`${id}-h`} class="num">
      <label for={`${id}-done`}>{label}</label>
    </h3>
    <div class="body">
      <slot />
    </div>
    {torque && (
      <p class="torque">
        <span class="k">torque</span> <span class="v">{torque}</span>
      </p>
    )}
    {photo && (
      <figure>
        <img src={photo} alt={photoAlt} loading="lazy" decoding="async" />
      </figure>
    )}
  </div>
</section>

<style>
  .step {
    display: grid;
    grid-template-columns: 24px 1fr;
    gap: var(--space-3);
    align-items: start;
    border-top: var(--border) solid var(--color-rule-strong);
    padding: var(--space-4) var(--space-2) var(--space-6);
  }
  .check {
    width: 24px;
    height: 24px;
    margin: 2px 0 0;
    accent-color: var(--color-text);
    cursor: pointer;
  }
  .content {
    min-width: 0;
  }
  .num {
    margin: 0 0 var(--space-2);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.02em;
    line-height: 28px; /* centers the label on the 24px checkbox */
    color: var(--color-text-muted);
  }
  .num label {
    cursor: pointer;
  }
  .body {
    max-width: var(--measure);
    font-size: var(--text-lg);
  }
  .body :global(p) {
    margin: 0 0 var(--space-3);
  }
  .body :global(p:last-child) {
    margin-bottom: 0;
  }
  .body :global(ul) {
    margin: var(--space-2) 0 var(--space-3);
  }
  .torque {
    display: inline-flex;
    gap: var(--space-3);
    margin: var(--space-3) 0 0;
    padding: var(--space-2) var(--space-3);
    border: var(--border) solid var(--color-rule-strong);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }
  .torque .k {
    color: var(--color-text-muted);
  }
  .torque .v {
    font-weight: 600;
  }
  figure {
    margin: var(--space-4) 0 0;
  }
  img {
    display: block;
    border: var(--border) solid var(--color-rule);
  }
  .step:has(.check:checked) .body,
  .step:has(.check:checked) .torque {
    color: var(--color-text-muted);
  }
  .step:has(.check:checked) .num {
    text-decoration: line-through;
  }
</style>
