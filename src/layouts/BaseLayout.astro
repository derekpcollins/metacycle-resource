---
import '../styles/base.css';
import { site, siteUrl } from '../site.config';
import SiteHeader from '../components/SiteHeader.astro';
import TabBar from '../components/TabBar.astro';
import SiteFooter from '../components/SiteFooter.astro';
import PageMeta from '../components/PageMeta.astro';

interface Props {
  title: string;
  description?: string;
  /** Repo-relative file to open in GitHub's editor ("edit this page"). */
  editPath?: string;
  /** Prefill for the "report a problem" form (contribution type, part id, system slug). */
  report?: { type?: string; part?: string; system?: string };
  /** Links backing the page's facts. */
  sources?: string[];
  /** Last-verified line in the page meta block ('never' or an ISO date). */
  lastVerified?: string;
  /** Contributors credited on this page (content `contributors` field). */
  contributors?: string[];
  /** Keep this page out of search engines even after launch (404, form results). */
  noindex?: boolean;
  /** schema.org objects to emit as JSON-LD. Only facts the page actually shows. */
  structuredData?: Record<string, unknown>[];
}

const {
  title,
  description = site.description,
  editPath,
  report,
  sources = [],
  lastVerified,
  contributors = [],
  noindex = false,
  structuredData = [],
} = Astro.props;
const pageTitle = title === site.name ? site.name : `${title} · ${site.name}`;
// One canonical URL per page: the chosen domain, no trailing slash (matches internal links).
const path = Astro.url.pathname.replace(/\/index\.html$|\.html$/, '').replace(/(.)\/$/, '$1');
const canonical = `${siteUrl}${path === '/' ? '/' : path}`;
// Production is the only build that may be indexed or counted; previews and local builds never.
const isProduction = process.env.VERCEL_ENV === 'production';
const robots = site.indexable && isProduction && !noindex ? 'index, follow' : 'noindex';
const analytics = isProduction ? site.analytics : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fafaf7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#111110" media="(prefers-color-scheme: dark)" />
    <!-- Before first paint: JS-only controls + saved theme (no flash, no layout shift). -->
    <script is:inline>
      // Runs before first paint: reveal JS-only controls and apply a saved theme choice.
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        try {
          var t = localStorage.getItem('theme');
          if (t === 'light' || t === 'dark') d.dataset.theme = t;
        } catch (e) {}
      })();
    </script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <!-- site.indexable is false until the public launch (private beta): noindex everywhere. -->
    <meta name="robots" content={robots} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {structuredData.map((data) => (
      <script
        is:inline
        type="application/ld+json"
        set:html={JSON.stringify({ '@context': 'https://schema.org', ...data })}
      />
    ))}
    {analytics && (
      <>
        <script is:inline async src={analytics.scriptUrl} />
        <script is:inline>
          ((window.plausible =
            window.plausible ||
            function () {
              (plausible.q = plausible.q || []).push(arguments);
            }),
            (plausible.init =
              plausible.init ||
              function (i) {
                plausible.o = i || {};
              }));
          plausible.init();
        </script>
      </>
    )}
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <SiteHeader />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <PageMeta
      sources={sources}
      lastVerified={lastVerified}
      editPath={editPath}
      report={report}
      contributors={contributors}
    />
    <SiteFooter />
    <TabBar />
    <script>
      // Close open menus (<details data-menu>) on outside tap or Escape. Menus work without JS.
      const menus = () => document.querySelectorAll<HTMLDetailsElement>('details[data-menu][open]');
      document.addEventListener('click', (e) => {
        menus().forEach((d) => {
          if (!d.contains(e.target as Node)) d.open = false;
        });
      });
      document.addEventListener('keydown', (e) => {
        if (e.key !== 'Escape') return;
        menus().forEach((d) => {
          d.open = false;
          d.querySelector('summary')?.focus();
        });
      });
    </script>
  </body>
</html>
